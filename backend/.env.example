# =====================================================================
# Variáveis de ambiente da API Nexum
# =====================================================================
# Dev local: copie este arquivo para "backend/.env" e preencha.
#   cp .env.example .env
# O .env NUNCA vai para o Git (está no .gitignore).
# Ele é lido por:
#   - a API (spring.config.import no application.yml), ao rodar de dentro de backend/;
#   - o docker compose (DB_USER e DB_PASSWORD viram o usuário/senha do Postgres local).
#
# Produção (Render): NÃO use arquivo. Cadastre cada variável em
#   Render > seu Web Service > Environment.
#
# Formato: CHAVE=valor, sem aspas e sem espaço em volta do "=".
# =====================================================================


# ---------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ---------------------------------------------------------------------
# DEV LOCAL (Postgres do docker-compose.yml):
#   DB_URL=jdbc:postgresql://localhost:5432/nexum
#   DB_USER e DB_PASSWORD: escolha os que quiser; o compose cria o banco com eles.
#
# PRODUÇÃO (Neon): o painel do Neon mostra uma connection string assim:
#
#   postgresql://USER:SENHA@HOST/neondb?sslmode=require
#
# O Java (JDBC) não aceita usuário e senha dentro da URL nesse formato. Separe em 3 partes:
#
#   DB_URL=jdbc:postgresql://HOST/neondb?sslmode=require
#   DB_USER=USER
#   DB_PASSWORD=SENHA
#
# Ou seja: troque "postgresql://" por "jdbc:postgresql://", tire o "USER:SENHA@" da URL
# e mantenha o resto (host, nome do banco e ?sslmode=require).
# Se a string do Neon tiver "&channel_binding=require", pode manter ou remover: o driver aceita os dois.
# Use o host DIRETO (sem "-pooler" no nome): o Flyway não combina com o pooler do Neon.
DB_URL=jdbc:postgresql://localhost:5432/nexum
DB_USER=nexum
DB_PASSWORD=


# ---------------------------------------------------------------------
# JWT (login)
# ---------------------------------------------------------------------
# Chave secreta que assina os tokens. Mínimo de 32 caracteres.
# Gere uma aleatória (Git Bash, Linux ou Mac):  openssl rand -base64 48
# Use uma chave DIFERENTE em produção. Se ela vazar, qualquer um cria tokens válidos.
JWT_SECRET=

# Validade do token, em horas (padrão: 168 = 7 dias).
JWT_EXPIRATION_HOURS=168


# ---------------------------------------------------------------------
# CORS: sites que podem chamar a API pelo navegador
# ---------------------------------------------------------------------
# Lista separada por vírgula, sem espaço e sem barra no final.
# Produção, por exemplo: https://nexumweb.onrender.com
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500


# ---------------------------------------------------------------------
# Administradores do painel (frontend/pages/admin.html)
# ---------------------------------------------------------------------
# Lista de e-mails separados por vírgula (sem espaço). Quem estiver aqui vira papel ADMIN
# ao iniciar a API e a cada cadastro/login; todos os outros ficam USER.
# Tirou um e-mail da lista? Reinicie a API (ou espere o próximo login dele) para perder o acesso.
# Vazio = ninguém é admin.
#   ADMIN_EMAILS=fulano@exemplo.com,ciclana@exemplo.com
ADMIN_EMAILS=


# ---------------------------------------------------------------------
# Fuso horário dos usuários (padrão America/Sao_Paulo). Define onde começa e termina
# cada mês nos filtros, no resumo e no orçamento. Opcional.
# ---------------------------------------------------------------------
APP_TIMEZONE=America/Sao_Paulo


# ---------------------------------------------------------------------
# Consultor IA (API do Claude, da Anthropic)
# ---------------------------------------------------------------------
# Chave da API: crie em https://platform.claude.com (Settings > API keys).
# OBRIGATÓRIA em produção para o Consultor funcionar. Sem ela, só as rotas /api/consultor
# respondem 503 ("Consultor IA indisponível no momento.") e o resto da API segue normal.
# Fica SÓ no backend: o front nunca vê a chave. Nunca commite o valor.
ANTHROPIC_API_KEY=

# Modelo usado nas respostas (padrão: claude-haiku-5-5, rápido e barato).
ANTHROPIC_MODEL=claude-haiku-5-5

# Perguntas por usuário por dia, contadas a partir de 00:00 no fuso APP_TIMEZONE (padrão: 20).
CONSULTOR_LIMITE_DIARIO=20

# Tamanho máximo de cada resposta, em tokens (padrão: 800).
CONSULTOR_MAX_TOKENS=800


# ---------------------------------------------------------------------
# Porta HTTP (padrão 8080). O Render define PORT sozinho: não cadastre lá.
# ---------------------------------------------------------------------
PORT=8080
